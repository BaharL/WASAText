# =========================
# Stage 1: build frontend
# =========================
FROM node:20-alpine AS build

WORKDIR /app

# Enable Corepack + Yarn 4.5.0
RUN corepack enable && corepack prepare yarn@4.5.0 --activate

# Copia PRIMA i file Yarn che definiscono il linker
COPY webui/.yarnrc.yml ./
COPY webui/.yarn/ ./.yarn/

# Copia manifest e lock
COPY webui/package.json webui/yarn.lock ./

# Install dipendenze (stato coerente)
RUN yarn install --immutable

# Copia il resto del frontend
COPY webui/ ./

# Build produzione
RUN yarn build

# =========================
# Stage 2: Nginx
# =========================
FROM nginx:alpine

# Copia output Vite
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
