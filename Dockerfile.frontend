FROM node:20-alpine AS build

WORKDIR /app/webui

RUN corepack enable && corepack prepare yarn@4.5.0 --activate

COPY webui/package.json webui/yarn.lock webui/.yarnrc.yml ./
COPY webui/.yarn/releases ./.yarn/releases

RUN yarn install --immutable

COPY webui ./
RUN yarn build-prod

FROM nginx:alpine

# 1) Copia i file buildati
COPY --from=build /app/webui/dist /usr/share/nginx/html

# 2) Copia la config Nginx (SPA fallback + proxy /api)
COPY webui/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
