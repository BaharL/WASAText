# Stage 1: build frontend (Vue/Vite)
FROM node:20-alpine AS build

# Lavoriamo direttamente dentro webui
WORKDIR /app/webui

# Yarn 4 via corepack
RUN corepack enable && corepack prepare yarn@4.5.0 --activate

# Copio SOLO manifest per cache layer
COPY webui/package.json webui/yarn.lock ./

# Install dipendenze
RUN yarn install

# Copio il resto del frontend
COPY webui/ ./

# Build produzione
RUN yarn build


# Stage 2: Nginx per servire i file statici
FROM nginx:alpine

COPY --from=build /app/webui/dist /usr/share/nginx/html

EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
