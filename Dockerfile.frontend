# Stage 1: build frontend (Vue/Vite)
FROM node:20-alpine AS build

WORKDIR /app/webui

# Enable Corepack (Yarn)
RUN corepack enable

# Copy ONLY the files needed for dependency install (cache-friendly)
COPY webui/package.json webui/yarn.lock webui/.yarnrc.yml ./

# If .yarnrc.yml contains yarnPath, we must copy the Yarn release too
COPY webui/.yarn/releases ./\.yarn/releases

# Install deps (must NOT change yarn.lock)
RUN yarn install --immutable --immutable-cache

# Copy the rest of the frontend
COPY webui/ ./

# Build production (your package.json has build-prod, not build)
RUN yarn build-prod


# Stage 2: Nginx serve static files
FROM nginx:alpine
COPY --from=build /app/webui/dist /usr/share/nginx/html
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
