# Stage 1: build frontend (Vue/Vite)
FROM node:20-alpine AS build

WORKDIR /app

# 1) Enable Corepack + prepare Yarn 4.5.0 (as requested by package.json)
RUN corepack enable \
 && corepack prepare yarn@4.5.0 --activate

# 2) Copio solo i file necessari per installare le dipendenze
COPY webui/package.json webui/yarn.lock ./

# 3) Ora `yarn install` usa Yarn 4.5.0, non la 1.22 globale
RUN yarn install

# 4) Copio il resto del frontend
COPY webui .

# Build produzione
RUN yarn build

# Stage 2: Nginx per servire i file statici
FROM nginx:alpine

# Copio la build Vite nella cartella pubblica di Nginx
COPY --from=build /app/dist /usr/share/nginx/html

# La view viene servita su 3000 (come da specifiche HW)
EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
