# Stage 1: build frontend (Vue/Vite)
FROM node:20-alpine AS build

WORKDIR /app/webui

# Enable Corepack + Yarn 4.5.0
RUN corepack enable && corepack prepare yarn@4.5.0 --activate

# Copy dependency files first (better cache)
COPY webui/package.json webui/yarn.lock ./

# Install deps (Yarn Berry)
RUN yarn install --immutable --immutable-cache

# Copy the rest of the frontend
COPY webui ./

# Build production (because there is NO "build" script)
RUN yarn build-prod

# Stage 2: Nginx serve static files
FROM nginx:alpine

COPY --from=build /app/webui/dist /usr/share/nginx/html

EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
