FROM golang:1.23-alpine AS builder

WORKDIR /app

# SQLite driver needs CGO + a C compiler
RUN apk add --no-cache gcc musl-dev

COPY . .

# Enable CGO so go-sqlite3 works
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o webapi ./cmd/webapi

FROM alpine:3

WORKDIR /app

COPY --from=builder /app/webapi ./webapi

# Make sure it's executable for any user
RUN chmod 755 ./webapi

EXPOSE 8080

CMD ["./webapi"]
